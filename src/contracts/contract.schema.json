{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrbitModuleContract",
  "type": "object",
  "required": ["id", "name", "version", "description", "tables", "api", "limits", "errorCodes", "files"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "tables": {
      "type": "array",
      "items": { "type": "string" }
    },
    "api": {
      "type": "object",
      "required": ["base", "endpoints"],
      "properties": {
        "base": { "type": "string" },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "methods"],
            "properties": {
              "path": { "type": "string" },
              "methods": {
                "type": "array",
                "items": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] }
              },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object"
    },
    "errorCodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "status", "i18nKey"],
        "properties": {
          "code": { "type": "string" },
          "status": { "type": "integer" },
          "i18nKey": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "files": {
      "type": "object",
      "required": ["actions", "queries", "ui", "i18n"],
      "properties": {
        "actions": { "type": "array", "items": { "type": "string" } },
        "queries": { "type": "array", "items": { "type": "string" } },
        "ui": { "type": "array", "items": { "type": "string" } },
        "i18n": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
