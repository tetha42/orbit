{
  "name": "orbit-community-os",
  "version": "2.0.0",
  "license": "Apache-2.0",
  "private": true,
  "bin": {
    "orbit": "./bin/orbit"
  },
  "scripts": {
    "setup": "node --no-warnings scripts/orbit-cli.mjs doctor",
    "doctor": "node --no-warnings scripts/orbit-cli.mjs doctor",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --port 3000",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "gen:apps": "node scripts/gen-apps.mjs && node scripts/gen-ai-index.mjs && node scripts/gen-docs.mjs",
    "check": "node --no-warnings scripts/orbit-cli.mjs verify --check",
    "verify": "tsc --noEmit && eslint --cache . && pnpm check",
    "build:fim": "node scripts/build-fim.mjs",
    "test": "node --test tests/contract/*.test.mjs",
    "test:e2e": "node tests/simulation/e2e-simulation.mjs",
    "test:security": "NEXT_TELEMETRY_DISABLED=1 node tests/security/security-e2e.mjs",
    "verify:landing": "node scripts/verify-landing-sync.mjs",
    "e2e": "NEXT_TELEMETRY_DISABLED=1 node --no-warnings --max-old-space-size=64 --max-semi-space-size=2 tests/e2e/ui/run.mjs",
    "demo": "node examples/oauth-client-node/server.mjs",
    "demo:setup": "npx tsx examples/oauth-client-node/setup.mjs",
    "example:oauth": "node examples/oauth-client-node/server.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "imapflow": "^2.12.1",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.74.0",
    "mailparser": "^3.14.5",
    "next": "^16.4.6",
    "nodemailer": "^10.6.0",
    "otplib": "^13.6.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.12.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "dompurify": "^3.4.17",
      "source-map-js": "^1.2.2",
      "zod": ">=4.6.6",
      "minimatch": ">=11.0.1"
    },
    "ignoredBuiltDependencies": [
      "core-js"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "useTabs": true
  }
}
