# Caddy reverse proxy in front of Next.js.
#
# SITE_ADDRESS controls the whole TLS story:
#   :80              plain HTTP — local development only
#   portal.example.com   automatic HTTPS via Let's Encrypt (needs ports 80+443)
#
# HTTPS is not optional in production: WebAuthn (passkeys) only works in a secure
# context. A browser refuses to register or assert a credential over plain HTTP on
# anything other than localhost, so passkeys silently fail without it.

{
	servers {
		trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP True-Client-IP X-Forwarded-For
	}
}

{$SITE_ADDRESS::80} {
	# Request/response size ceiling for uploads (receipt photos, documents).
	request_body {
		max_size 10MB
	}

	# Live events (Server-Sent Events): a stream that stays open for hours. No
	# compression and no response buffering (flush_interval -1 writes every chunk
	# through at once), no timeout on the open response, and a config reload keeps
	# open streams for a while instead of cutting them (the browser reconnects anyway).
	@sse path /api/stream* /api/events* /api/chat/stream* /api/soc/stream* /api/terminal/stream*
	handle @sse {
		reverse_proxy 127.0.0.1:3000 {
			flush_interval -1
			stream_close_delay 5m
			transport http {
				read_timeout 0
				response_header_timeout 30s
			}
			header_up Host {host}
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy 127.0.0.1:3000 {
			header_up Host {host}
			header_up X-Real-IP {client_ip}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
		# Only meaningful over TLS; Caddy ignores it on plain HTTP.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	log {
		output stdout
		format console
	}
}
